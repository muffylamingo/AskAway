@model IEnumerable<AskAway.Models.Question>

@{
    ViewData["Title"] = "Question Bank";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/lobby.css">
    <style>
        /* Question Library Specific Styles */
        .admin-container {
            min-height: 100vh;
            height: auto; /* Sabit boyu kaldırıyoruz */
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            padding: 40px 20px;
            position: relative;
            overflow-y: visible; /* Gizli kaydırmayı açıyoruz */
        }

        body, html {
            overflow-y: auto !important;
            height: auto !important;
        }
        .admin-container::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image:
                radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
            animation: float 20s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        .admin-content {
            position: relative;
            z-index: 1;
        }

        .admin-header {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 30px 40px;
            margin-bottom: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .admin-title {
            font-size: 2.5rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-title .icon {
            font-size: 2.8rem;
        }

        .question-grid {
            display: grid;
            gap: 20px;
            margin-bottom: 30px;
        }

        .question-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 25px 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.3s ease;
            animation: slideUp 0.4s ease;
        }

        .question-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
        }

        .question-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            gap: 15px;
        }

        .question-id {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            font-weight: 900;
            font-size: 0.9rem;
            padding: 8px 16px;
            border-radius: 12px;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(102, 126, 234, 0.4);
        }

        .question-text {
            flex: 1;
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.5;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .options-list {
            display: grid;
            gap: 10px;
            margin-bottom: 20px;
        }

        .option-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.1);
            padding: 12px 18px;
            border-radius: 12px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            transition: all 0.2s ease;
        }

        .option-item:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .option-letter {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: #fff;
            font-weight: 900;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 1.1rem;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(240, 147, 251, 0.3);
        }

        .option-text {
            color: rgba(255, 255, 255, 0.95);
            font-size: 1rem;
            font-weight: 600;
        }

        .card-actions {
            display: flex;
            justify-content: flex-end;
        }

        .btn-delete {
            padding: 12px 25px;
            font-size: 1rem;
        }

        .empty-state {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 60px 40px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            margin-bottom: 30px;
        }

        .empty-icon {
            font-size: 5rem;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        .empty-title {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 15px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .empty-message {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 30px;
        }

        .footer-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        @@media (max-width: 768px) {
            .admin-header {
                flex-direction: column;
                align-items: stretch;
            }

            .admin-title {
                font-size: 2rem;
                justify-content: center;
            }

            .question-header {
                flex-direction: column;
            }

            .question-text {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="container mt-5 admin-content">
            <!-- Header Section -->
            <div class="admin-header">
                <h1 class="admin-title">
                    <span class="icon">📚</span>
                    Question Bank
                </h1>
                <a asp-action="Create" class="game-btn btn-primary-game">
                    <span class="btn-icon">➕</span>
                    Add New Question
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                <!-- Questions Grid -->
                <div class="question-grid">
                    @foreach (var question in Model)
                    {
                        <div class="question-card">
                            <div class="question-header">
                                <div class="question-id"># @question.Id</div>
                                <div class="question-text">@question.Text</div>
                            </div>

                            <div class="options-list">
                                <div class="option-item">
                                    <div class="option-letter">A</div>
                                    <div class="option-text">@question.OptionA</div>
                                </div>
                                <div class="option-item">
                                    <div class="option-letter">B</div>
                                    <div class="option-text">@question.OptionB</div>
                                </div>
                                <div class="option-item">
                                    <div class="option-letter">C</div>
                                    <div class="option-text">@question.OptionC</div>
                                </div>
                                <div class="option-item">
                                    <div class="option-letter">D</div>
                                    <div class="option-text">@question.OptionD</div>
                                </div>
                                <div class="option-item">
                                    <div class="option-letter">E</div>
                                    <div class="option-text">@question.OptionE</div>
                                </div>
                            </div>

                            <div class="card-actions">
                                <form asp-action="Delete" asp-route-id="@question.Id" method="post" style="display: inline;">
                                    <button type="submit" class="game-btn btn-leave btn-delete" onclick="return confirm('Are you sure you want to delete this question?');">
                                        <span class="btn-icon">🗑️</span>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="empty-state">
                    <div class="empty-icon">📝</div>
                    <h2 class="empty-title">No Questions Yet!</h2>
                    <p class="empty-message">Your question bank is empty. Start building your game by adding some exciting questions!</p>
                    <a asp-action="Create" class="game-btn btn-primary-game">
                        <span class="btn-icon">➕</span>
                        Create Your First Question
                    </a>
                </div>
            }

            <!-- Footer Navigation -->
            <div class="footer-actions">
                <a asp-controller="Home" asp-action="Index" class="game-btn btn-secondary-game">
                    <span class="btn-icon">🏠</span>
                    Back to Game
                </a>
            </div>
        </div>
    </div>
</body>
</html>